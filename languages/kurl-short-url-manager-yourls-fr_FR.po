msgid "Imported old URL: %s"
msgstr "URL ancienne importée : %s"

msgid "Imported:"
msgstr "Importé :"

msgid ""
"Install the official kURL helper extension on your YOURLS server to enable "
"remote deletion and safe long-URL lookup for sync and cleanup features."
msgstr ""
"Installez l’extension officielle kURL Helper sur votre serveur YOURLS afin "
"d’activer la suppression à distance et la recherche sécurisée d’URL longues "
"pour les fonctions de synchronisation et de nettoyage."

msgid "Invalid API action."
msgstr "Action API invalide."

msgid "Invalid JSON response from YOURLS."
msgstr "Réponse JSON invalide de YOURLS."

msgid "Invalid post."
msgstr "Publication invalide."

