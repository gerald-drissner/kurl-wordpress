msgstr ""
"Activer la suppression à distance véritable et la recherche sécurisée "
"(optionnelle)"

msgid "Enabled post types"
msgstr "Types de publications activés"

msgid "Endpoint not found. Check the API URL."
msgstr "Endpoint non trouvé. Vérifiez l’URL de l’API."

msgid ""
"Enter your main YOURLS domain (for example <code>https://yalla.li</code>). "
"kURL will automatically append <code>/yourls-api.php</code> when needed."
msgstr ""
"Saisissez votre domaine principal YOURLS (par exemple <code>https://yalla."
"li</code>). kURL ajoutera automatiquement <code>/yourls-api.php</code> si "
"nécessaire."

