msgstr "Liens :"

msgid ""
"Local cleanup finished. Keywords removed: %1$d, stats removed: %2$d, URLs "
"normalized: %3$d."
msgstr ""
"Nettoyage local terminé. Mots-clés supprimés : %1$d, statistiques "
"supprimées : %2$d, URL normalisées : %3$d."

