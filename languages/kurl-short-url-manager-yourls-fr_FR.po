"Navigate to <code>user/plugins/</code> and create a folder named <code>kurl-"
"api</code>."
msgstr ""
"Allez dans <code>user/plugins/</code> et créez un dossier nommé <code>kurl-"
"api</code>."

msgid "No code found to copy."
msgstr "Aucun code trouvé à copier."

