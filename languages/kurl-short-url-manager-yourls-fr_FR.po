msgstr "Erreur"

msgid "Error:"
msgstr "Erreur :"

msgid "Errors:"
msgstr "Erreurs :"

msgid "Existing links"
msgstr "Liens existants"

msgid ""
"Experimental tools to compare WordPress content with your YOURLS database "
"and clean stale local data."
msgstr ""
"Outils expérimentaux pour comparer le contenu WordPress avec votre base "
"YOURLS et nettoyer les données locales obsolètes."

msgid "Experimental:"
msgstr "Expérimental :"

msgid ""
"Experimental: Check whether YOURLS already has a short URL for this "
"permalink and sync it into WordPress."
msgstr ""
"Expérimental : vérifie si YOURLS possède déjà une URL courte pour ce "
"permalien et la synchronise dans WordPress."

msgid "Failed to copy code. Please copy it manually."
msgstr "Échec de copier le code. Veuillez le copier manuellement."

msgid "Fetched from the YOURLS API"
msgstr "Récupéré depuis l’API YOURLS"

msgid "Forbidden. Check your signature or a firewall/security layer."
msgstr "Interdit. Vérifiez votre signature ou un pare-feu/couche de sécurité."

msgid "Generate / Update"
msgstr "Générer / Mettre à jour"

#, python-format
msgid "HTTP error %d."
msgstr "L’erreur HTTP %d."

msgid ""
"Import first, verify a few posts, then delete the old Better YOURLS data "
"once everything looks correct."
msgstr ""
"Importez d’abord, vérifiez quelques contenus, puis supprimez les anciennes "
"données Better YOURLS une fois que tout semble correct."

msgid "Import from Better YOURLS"
msgstr "Importer depuis Better YOURLS"

msgid "Import old Better YOURLS first"
msgstr "Importez d’abord les anciens Better YOURLS"

msgid "Imported %1$d old links and skipped %2$d existing ones."
msgstr "J’ai importé %1$d anciens liens et j’ai sauté %2$d liens existants."

